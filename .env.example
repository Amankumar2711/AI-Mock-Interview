# ==============================================================================
# .env.example — AI-Interview Evaluation API
#
# Copy this file to .env and fill in your values before starting the project.
# NEVER commit .env to version control — it contains secrets.
#
# In CI/CD pipelines (GitHub Actions, GitLab CI, etc.), inject these as
# environment secrets and generate .env at pipeline runtime:
#   echo "API_KEY=${{ secrets.API_KEY }}" >> .env
#   echo "APP_ENV=prod" >> .env
# ==============================================================================

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=prod                   # REQUIRED for prod: must be "prod", NOT "dev"
APP_HOST=0.0.0.0
APP_PORT=8005
# REQUIRED for prod: comma-separated list of your actual frontend origins.
# NEVER use * in production — the startup validator will reject it.
CORS_ORIGINS=https://your-app.example.com

# ── Security ───────────────────────────────────────────────────────────────────
# REQUIRED: Change this from the default before deploying.
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=CHANGE_ME_BEFORE_DEPLOYING

# ── Redis ──────────────────────────────────────────────────────────────────────
# In Docker Compose, these are overridden by the environment: block.
# Only needed for local/non-Docker runs.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── LLM Backend ────────────────────────────────────────────────────────────────
LLM_BACKEND=vllm               # prod: vllm | dev: ollama | cloud: openai
OLLAMA_MODEL=qwen2.5:0.5b-instruct

# ── vLLM Production Settings ───────────────────────────────────────────────────
# These control the vllm container started by: docker-compose --profile prod up
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ   # model to load (must match EMBEDDING_MODEL_NAME if sharing)
VLLM_PORT=8001                         # host port; internal Docker port is always 8001
VLLM_DTYPE=float16                     # float16 | bfloat16 | auto
VLLM_MAX_MODEL_LEN=4096               # max context tokens
VLLM_GPU_MEM_UTIL=0.45                # fraction of VRAM (0.0-1.0) — shared GPU with other services
VLLM_TENSOR_PARALLEL=1               # number of GPUs to shard model across
# HuggingFace token — not required for Qwen2.5 (open-access), but set it
# for higher rate limits during initial model download.
# Also used at Dockerfile build time: docker build --build-arg HF_TOKEN=$HF_TOKEN .
HF_TOKEN=hf_REPLACE_WITH_YOUR_TOKEN

# ── Embeddings (Technical Evaluation) ─────────────────────────────────────────
# In prod, embeddings are served by vLLM. Must match the model loaded in vLLM.
# EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
# EMBEDDING_API_URL=http://vllm:8001/v1/embeddings  # auto-built from VLLM_HOST/PORT
# EMBEDDING_API_KEY=                                # leave empty for self-hosted vLLM

# ── Worker Sizing ──────────────────────────────────────────────────────────────
# Rule of thumb: WORKER_COUNT = floor(available_RAM_GB / 4)
# If unset, auto-detected from RAM at startup.
WORKER_COUNT=4
TASK_SOFT_TIMEOUT=300          # 5 min soft limit per task
TASK_HARD_TIMEOUT=360          # 6 min hard kill limit

# ── Session / Cache TTL (seconds) ──────────────────────────────────────────────
SESSION_TTL=3600               # 1 hour
RESULT_TTL=7200                # 2 hours

# ── Hardware Overrides (auto-detected if unset) ────────────────────────────────
# WHISPER_MODEL=base           # tiny | base | small | medium | large
# BATCH_SIZE=2

# ── Upload Auto-Cleanup ────────────────────────────────────────────────────────
UPLOAD_MAX_AGE_S=3600
UPLOAD_CLEANUP_INTERVAL_S=300

# ── WebSocket ──────────────────────────────────────────────────────────────────
WS_POLL_INTERVAL=1.0

# ── Prometheus / Monitoring ────────────────────────────────────────────────────
METRICS_POLL_INTERVAL_S=15
WARN_QUEUE_DEPTH=50
WARN_ACTIVE_TASKS=20
WARN_ZERO_WORKERS=true

# ── Grafana & Flower (--profile monitoring) ────────────────────────────────────
# REQUIRED: Change both passwords before deploying.
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_BEFORE_DEPLOYING
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME_BEFORE_DEPLOYING
